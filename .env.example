PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# Production (Railway): localhost CLIENT_ORIGIN is ignored.
# Set GOOGLE_CALLBACK_URL=https://<your-app>.up.railway.app/auth/google/callback
# Set to 1 to show a local "Continue without Google" button when OAuth is unset.
DEV_LOGIN=1
# Comma-separated emails that can open /admin.
ADMIN_EMAILS=

# Leave unset for local SQLite (server/data/fovea.db).
# In production, set a Postgres URL:
# DATABASE_URL=postgres://user:pass@host:5432/fovea
# PGSSL=0
