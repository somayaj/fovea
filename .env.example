PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# Production (Railway): use HTTPS for all public URLs
# PUBLIC_APP_URL=https://fovea.sh
# CLIENT_ORIGIN=https://fovea.sh
# GOOGLE_CALLBACK_URL=https://fovea.sh/auth/google/callback
# Set to 1 to show a local "Continue without Google" button when OAuth is unset.
DEV_LOGIN=1
# Comma-separated emails that can open /admin.
ADMIN_EMAILS=

# Google Analytics 4 — set in Railway for production only (not in local .env).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional separate property for staging/preview hosts (never localhost):
# VITE_GA_MEASUREMENT_ID_DEV=G-YYYYYYYYYY
# In GA4, add a data filter to exclude hostname "localhost" as a belt-and-suspenders guard.

# Leave unset for local SQLite (server/data/fovea.db).
# In production, set a Postgres URL:
# DATABASE_URL=postgres://user:pass@host:5432/fovea
# PGSSL=0
